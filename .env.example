SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
TESSERACT_CMD=/usr/bin/tesseract

LLM_PROVIDER=vllm
LLM_BASE_URL=http://trustmail-llm:8000/v1/chat/completions
LLM_MODEL=qwen2.5-7b-instruct
LLM_TIMEOUT=300
LLM_MAX_CONTEXT_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS=700
LLM_SCAN_MODE=balanced

DATABASE_URL=postgresql://trustmail:trustmail@postgres:5432/trustmail
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-before-production
JWT_EXPIRES_MINUTES=1440
TRUSTMAIL_PRODUCTION=false
TRUSTMAIL_REQUIRE_AUTH=false
TRUSTMAIL_ADMIN_EMAIL=admin@trustmail.local
TRUSTMAIL_ADMIN_PASSWORD=change-me-before-production
GMAIL_POLL_INTERVAL_SECONDS=60
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_OAUTH_REDIRECT_URI=https://YOUR_DOMAIN/api/gmail/oauth/callback
PASSWORD_RESET_URL_BASE=https://YOUR_DOMAIN/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
MAX_UPLOAD_BYTES=10485760
EXPO_ACCESS_TOKEN=

# ── Feature Flags ──────────────────────────────────────────────────────────
# Each flag defaults to a safe value. Set to true/false to enable/disable.
# Feature 1: QR-code phishing (quishing) detection in images/screenshots/PDFs
FEATURE_QR_DETECTION_ENABLED=true
# Feature 2: Prompt-injection defense for the LLM layer
FEATURE_PROMPT_INJECTION_GUARD_ENABLED=true
# Feature 3: Offline hash-prefix safe-browsing check (k-anonymity, 100% local lookups)
FEATURE_OFFLINE_SAFEBROWSING_ENABLED=true
# Leave empty to disable auto-sync. Examples:
#   OpenPhish feed:  OFFLINE_HASH_FEED_URL=https://openphish.com/feed.txt
#   PhishTank feed:  OFFLINE_HASH_FEED_URL=https://data.phishtank.com/data/online-valid.csv
OFFLINE_HASH_FEED_URL=
OFFLINE_HASH_SYNC_INTERVAL_HOURS=6
# Feature 4: Campaign correlation (detect coordinated phishing campaigns)
FEATURE_CAMPAIGN_CORRELATION_ENABLED=true
CAMPAIGN_CORRELATION_WINDOW_HOURS=48
CAMPAIGN_CORRELATION_MIN_MATCHES=3
# Feature 5: Adaptive trust baseline (per-sender behavioral history)
FEATURE_ADAPTIVE_TRUST_ENABLED=true
# Minimum trusted scans before trust bonus is applied
ADAPTIVE_TRUST_MIN_SCANS=3
