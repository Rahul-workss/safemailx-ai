SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
TESSERACT_CMD=/usr/bin/tesseract

LLM_PROVIDER=vllm
LLM_BASE_URL=http://trustmail-llm:8000/v1/chat/completions
LLM_MODEL=qwen2.5-7b-instruct
LLM_TIMEOUT=300
LLM_MAX_CONTEXT_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS=700
LLM_SCAN_MODE=balanced

DATABASE_URL=postgresql://trustmail:trustmail@postgres:5432/trustmail
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-before-production
JWT_EXPIRES_MINUTES=1440
TRUSTMAIL_PRODUCTION=false
TRUSTMAIL_REQUIRE_AUTH=false
TRUSTMAIL_ADMIN_EMAIL=admin@trustmail.local
TRUSTMAIL_ADMIN_PASSWORD=change-me-before-production
GMAIL_POLL_INTERVAL_SECONDS=60
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_OAUTH_REDIRECT_URI=https://YOUR_DOMAIN/api/gmail/oauth/callback
PASSWORD_RESET_URL_BASE=https://YOUR_DOMAIN/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
MAX_UPLOAD_BYTES=10485760
EXPO_ACCESS_TOKEN=
