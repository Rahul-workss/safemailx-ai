{
  "expo": {
    "name": "SafeMail X AI",
    "slug": "safemailx-ai",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/custom-shield.png",
    "userInterfaceStyle": "dark",
    "scheme": "safemailxai",
    "splash": {
      "image": "./assets/custom-shield.png",
      "resizeMode": "contain",
      "backgroundColor": "#080B12"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "tech.safemailx.safemailxai",
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/custom-shield.png",
        "backgroundColor": "#080B12"
      },
      "intentFilters": [
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "text/plain"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ]
    },
    "updates": {
      "enabled": false
    },
    "extra": {
      "eas": {
        "projectId": "687ea9b6-97d1-4434-b8cc-fcb57eeace22"
      }
    },
    "owner": "jnvra",
    "plugins": [
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Allow SafeMail X AI to access your camera for scanning documents." }],
      ["expo-image-picker", { "photosPermission": "Allow SafeMail X AI to access your photos." }],
      ["@react-native-voice/voice", { "microphonePermission": "Allow SafeMail X AI to use the microphone to transcribe call descriptions." }]
    ]
  }
}
